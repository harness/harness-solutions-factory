
terraform {
  backend "http" {
    address = "${WORKSPACE}/terraform-backend?accountIdentifier=${HARNESS_ACCOUNT}"
    username = "harness"
    password = "${HARNESS_APIKEY}"
    lock_address = "${WORKSPACE}/terraform-backend/lock?accountIdentifier=${HARNESS_ACCOUNT}"
    lock_method = "POST"
    unlock_address = "${WORKSPACE}/terraform-backend/lock?accountIdentifier=${HARNESS_ACCOUNT}"
    unlock_method = "DELETE"
  }
}

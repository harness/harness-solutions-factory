// Harness Account Connection
# The Harness Platform URL (defaults to Harness SaaS)
harness_platform_url = "https://app.harness.io/gateway"

# The Harness Platform Account Number (falls back to HARNESS_ACCOUNT_ID env var)
harness_platform_account = null

# The Harness organization ID (must exist before execution)
organization_id = "Harness_Platform_Management"

# The Harness project ID where factory-floor will be deployed
project_id = # Required

# Create HSF Core Manager workspace (only valid when should_use_harness_idp is false)
should_create_hsf_core_mgr_workspace = true

# Enable Harness IDP for the Solutions Factory
should_use_harness_idp = null

// Factory Floor Master configuration
# Reference to existing Harness Platform API key (secret reference)
existing_harness_platform_key_ref = null

# Git connector reference for template library deployment
git_connector_ref = null

# Git repository name for template library
git_repository_name = null

# Git source reference (branch name, tag, or commit SHA)
git_repository_branch = null

// Kubernetes Configurations and Settings
# Kubernetes connector reference for pipeline execution
kubernetes_connector = null

# Kubernetes namespace for pipeline execution
kubernetes_namespace = null

# Kubernetes service account for pipeline execution
kubernetes_serviceaccount = null

# Kubernetes pod runAs user ID override (must be a valid Unix integer or null)
kubernetes_override_run_as_user = null

# Kubernetes node selectors for pod scheduling
kubernetes_node_selectors = {}

# Container registry connector for custom provisioner images
kubernetes_override_image_connector = null

# Custom container image for provisioner (terraform/opentofu binary). Path relative to kubernetes_override_image_connector
kubernetes_override_image_name = null

// Provisioner Type and Version
# Default provisioner type: 'terraform' or 'opentofu'
provisioner_type = null

# Default provisioner version for all deployments
provisioner_version = null

// HSF Plugin Configurations and Settings
# Container registry connector for HSF pipeline images (defaults to org.hsf_dockerhub_connector)
hsf_pipeline_connector_ref = null

# HSF Script Manager image (relative to hsf_pipeline_connector_ref)
hsf_script_mgr_image = null

# HSF IACM Workspace Manager plugin (relative to hsf_pipeline_connector_ref)
hsf_iacm_manager_plugin = null

# HSF IDP Resource Manager image (relative to hsf_pipeline_connector_ref)
hsf_idp_resource_mgr_image = null

# HSF Token Rotation plugin image (relative to hsf_pipeline_connector_ref)
hsf_rotate_token_plugin = null

# Enforce strict SSL RFC5280 compliance for HSF plugins
hsf_plugin_ssl_verify_x509_strict = null

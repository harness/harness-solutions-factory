#######
# Harness Account Setup
#######
# The Harness Platform URL (defaults to Harness SaaS)
harness_platform_url = "https://app.harness.io/gateway"

# The Harness Platform Account Number (falls back to HARNESS_ACCOUNT_ID env var)
harness_platform_account = null

# The Harness organization ID (must exist before execution)
organization_id = "Harness_Platform_Management"

# The Harness project ID for Solutions Factory
project_id = "Solutions_Factory"

#######
# SCM Source Configurations and Settings
#######
# Existing Harness SCM connector reference. Use 'skipped' for the default official repositories connector. Prefix account/org connectors with 'account.' or 'org.' as needed
hsf_source_connector = "skipped"

# SCM repository for IACM workspaces (defaults to official Harness Solutions Factory repository)
hsf_source_repository = "harness-solutions-factory"

# SCM fetch type: 'branch', 'tag', or 'sha'
hsf_source_fetch_type = "tag"

# SCM source reference (branch name, tag, or commit SHA) for IACM workspaces
hsf_source_branch = "v2.5.2"

# Reference to existing Harness Platform API key (secret reference)
existing_harness_platform_key_ref = # Required

#######
# Harness Template Library Source Code Manager configuration
#######
# Git connector reference for template library deployment. Use 'skipped' to default to account variable custom_template_library_connector
git_connector_ref = "skipped"

# Git repository name for template library. Use 'skipped' to default to account variable custom_template_library_repo
git_repository_name = "skipped"

# Git fetch type: 'branch', 'tag', 'sha', or 'skipped' (uses account default)
git_repository_fetch_type = "skipped"

# Git source reference (branch name, tag, or commit SHA). Use 'skipped' to default to account variable custom_template_library_fetch_key
git_repository_branch = "skipped"

#######
# Kubernetes Configurations and Settings
#######
# Kubernetes connector reference for pipeline execution (use 'skipped' for Harness-managed infrastructure)
kubernetes_connector = "skipped"

# Kubernetes namespace for pipeline execution
kubernetes_namespace = "default"

# Kubernetes service account for pipeline execution (use 'skipped' for default)
kubernetes_serviceaccount = "skipped"

# Kubernetes pod runAs user ID override (must be a valid Unix integer, or 'skipped')
kubernetes_override_run_as_user = "skipped"

# Kubernetes node selectors for pod scheduling
kubernetes_node_selectors = {}

# Container registry connector for custom provisioner images (use 'skipped' for default)
kubernetes_override_image_connector = "skipped"

# Custom container image for provisioner (terraform/opentofu binary). Path relative to kubernetes_override_image_connector
kubernetes_override_image_name = "skipped"

# Default provisioner type: 'terraform' or 'opentofu'
provisioner_type = "opentofu"

# Default provisioner version for all deployments
provisioner_version = "1.12.3"

# Enable Mini-Factory for distributed IDP workflow execution
enable_hsf_mini_factory = false

# Enable Harness IDP for the Solutions Factory
should_use_harness_idp = true

# Deploy the HSF Hub for centralized workspace management
should_use_hsf_hub = false

#######
# HSF Plugin Configurations and Settings
#######
# Container registry connector for HSF pipeline images (defaults to org.hsf_dockerhub_connector)
hsf_pipeline_connector_ref = "org.hsf_dockerhub_connector"

# HSF Script Manager image (relative to hsf_pipeline_connector_ref)
hsf_script_mgr_image = "harnesssolutionfactory/harness-python-api-sdk:v1.14.0"

# HSF Token Rotation plugin image (relative to hsf_pipeline_connector_ref)
hsf_rotate_token_plugin = "harnesssolutionfactory/harness-token-rotation:v1.2.4"

# HSF IACM Workspace Manager plugin image (relative to hsf_pipeline_connector_ref)
hsf_iacm_manager_plugin = "harnesssolutionfactory/harness-manage-iacm-workspace:v1.7.7"

# HSF IDP Resource Manager image (relative to hsf_pipeline_connector_ref)
hsf_idp_resource_mgr_image = "harnesssolutionfactory/harness-idp-resource-manager:v1.3.6"

# Enforce strict SSL RFC5280 compliance for HSF plugins
hsf_plugin_ssl_verify_x509_strict = true
